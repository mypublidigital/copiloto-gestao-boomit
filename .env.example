# Copie para .env.local (que não vai para o Git) e preencha.
# Use aspas simples se algum valor tiver caracteres especiais: CHAVE='valor'
# O Claude Code não lê este arquivo preenchido: ele usa scripts/com-env.sh.

# --- Sprint 0 · Supabase (projeto de desenvolvimento na organização Leadrix) ---
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# --- Sprint 0 · Front (mesmos valores do Supabase acima) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MODO_DEMO=true
# Senha das personas fictícias do modo demonstração (gerada pelo Claude Code; só dados fictícios).
VITE_DEMO_SENHA=

# --- Sprint 0 (checkpoint 3) · IA ---
ANTHROPIC_API_KEY=
MODELO_PRINCIPAL=claude-sonnet-5-5
MODELO_RAPIDO=claude-haiku-5-5
MODELO_AVALIACAO=claude-opus-5-5

# --- Fonte de dados Boomit: mock (fixtures) | api ---
BOOMIT_FONTE=mock

# --- Sprint 0 (checkpoint 4) · Hospedagem do front (opcional se você logar via terminal) ---
VERCEL_TOKEN=
# Opcional: slug do time na Vercel, quando o token tem acesso a mais de um.
VERCEL_TIME=

# --- Sprint 1 · API Boomit (quando copiloto-export existir) ---
BOOMIT_API_URL=
BOOMIT_API_TOKEN=
BOOMIT_WEBHOOK_SECRET=

# --- E-mail transacional (régua de lembretes e insights semanais) ---
# Provedor: Resend (resend.com). Sem chave, os e-mails ficam na caixa de saída do app.
EMAIL_API_KEY=
# Remetente verificado no provedor, ex.: Copiloto <copiloto@seudominio.com>
EMAIL_REMETENTE=
# Personas de demonstração NUNCA recebem e-mail. Com este endereço, as cópias vão para ele.
EMAIL_DESTINO_TESTE=
# Endereço do app nos links dos e-mails (padrão: a demonstração na Vercel)
APP_URL=
