{
  "name": "copiloto-gestao-boomit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rls": "node scripts/testar-rls.mjs local",
    "test:rls:remoto": "bash scripts/com-env.sh 'node scripts/testar-rls.mjs remoto'",
    "verificar": "npm run typecheck && npm run lint && npm test && npm run test:rls",
    "db:aplicar": "bash scripts/com-env.sh 'node scripts/aplicar-migrations.mjs'",
    "db:tipos": "bash scripts/com-env.sh 'bash scripts/gerar-tipos.sh'",
    "seed:demo": "bash scripts/com-env.sh 'node scripts/seed-demo.ts'",
    "verificar:producao": "bash scripts/com-env.sh 'node scripts/verificar-build-producao.mjs'",
    "ensaio:ia": "bash scripts/com-env.sh 'node scripts/ensaio-ia.ts'",
    "db:agendador": "bash scripts/com-env.sh 'node scripts/configurar-agendador.mjs'",
    "db:segredos": "node scripts/gravar-segredos-funcoes.mjs",
    "publicar:demo": "bash scripts/com-env.sh 'node scripts/publicar-demo.mjs'",
    "ensaio:tipos": "bash scripts/com-env.sh 'node scripts/ensaio-tipos.ts'",
    "ensaio:documento": "bash scripts/com-env.sh 'node scripts/ensaio-documento.ts'",
    "ensaio:decisao": "bash scripts/com-env.sh 'node scripts/ensaio-decisao.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
